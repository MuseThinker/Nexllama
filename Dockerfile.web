# The whole app on one port: the daemon serves the built UI from `--ui-dir` and
# answers the API on the same port, so there is no second process to configure
# and no proxy to forward a token.
#
# No `# syntax=` line: this file uses nothing from the BuildKit frontend, and
# asking for it means the build fails outright behind a registry mirror that
# cannot serve `docker/dockerfile:1` — a failure that has nothing to do with
# this image.
#
# Build:
#   docker build -f Dockerfile.web -t nexllama/nexllama:web .
#   docker build --build-arg CRATES_MIRROR=https://rsproxy.cn/index/ -f Dockerfile.web -t nexllama/nexllama:web .
#
# Run:
#   docker run --rm -p 8090:8090 -v "$PWD/models:/models:ro" \
#     nexllama/nexllama:web
#   # with a token, pasted into the app's Settings page:
#   docker run --rm -p 8090:8090 -e NEXLLAMA_API_KEY=$(openssl rand -hex 16) \
#     -v "$PWD/models:/models:ro" nexllama/nexllama:web

# The UI is a static bundle; only its build needs Node. The engine that serves
# it is the same Rust daemon as the API-only image, built here with the UI's
# sibling crates present (`model-index`, which is how `/admin/models` and the
# desktop library agree on what a model is).
FROM node:22-bookworm-slim AS ui

WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM rust:1-bookworm AS builder

ARG CRATES_MIRROR=
ARG FEATURES=

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      clang libclang-dev llvm-dev cmake ninja-build pkg-config \
 && rm -rf /var/lib/apt/lists/*

RUN if [ -n "$CRATES_MIRROR" ]; then \
      printf '[source.crates-io]\nreplace-with = "mirror"\n\n[source.mirror]\nregistry = "sparse+%s"\n' "$CRATES_MIRROR" > "$CARGO_HOME/config.toml"; \
    fi

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
# Every workspace member, not just the daemon's own path dependencies: the root
# `Cargo.toml` names them all, so one missing manifest is a hard error before
# anything is compiled — and the list only grows. `crates/app` is the desktop
# app's own workspace and is excluded in `.dockerignore`.
COPY crates ./crates

RUN if [ -n "$FEATURES" ]; then \
      cargo build --release -p infer-daemon --features "$FEATURES"; \
    else \
      cargo build --release -p infer-daemon; \
    fi

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 libstdc++6 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/target/release/infer-daemon /usr/local/bin/infer-daemon
# The llama.cpp shared libraries go in a library directory, not in `bin`: the
# dynamic loader does not search `bin`, so the binary only started by luck of
# whatever fallback this base image happened to have.
COPY --from=builder /src/target/release/*.so* /usr/local/lib/
RUN ldconfig

# The app the daemon serves from `--ui-dir`.
COPY --from=ui /ui/dist /app/ui

# Unprivileged: reading model files and serving a port needs no root, and the
# daemon parses whatever GGUF it is pointed at.
RUN useradd --system --no-create-home --uid 10001 nexllama
USER nexllama

ENV RUST_LOG=info
EXPOSE 8090
VOLUME ["/models"]

ENTRYPOINT ["infer-daemon"]

# No model is named here: the app loads whatever the library lists, which is
# what `--models-dir` gives it. To pin one instead, append the flag to the
# command — `docker run … nexllama/nexllama:web --model /models/x.gguf` — or set
# `command:` in compose. Listing first and loading from the app is the point of
# this image; a hardcoded model would make the library a second place to look.
#
# `--allow-unauthenticated` is the default and not a mistake: the image binds
# 0.0.0.0 and nothing in front of it authenticates callers, so a deployment that
# leaves this reachable from a network should set `NEXLLAMA_API_KEY`. The daemon
# reads that variable itself, so setting it is the whole opt-in: every route but
# `/health` then wants `Authorization: Bearer <token>`, and the app's Settings
# page is where the token gets pasted. The flag stays, because it only says the
# operator meant to expose the port — it does not disable a key that is set.
CMD ["--host", "0.0.0.0", "--port", "8090", \
     "--ui-dir", "/app/ui", "--models-dir", "/models", \
     "--allow-unauthenticated"]