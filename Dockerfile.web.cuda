# Requires the NVIDIA Container Toolkit on the host.
#
# No `# syntax=` line: this file uses nothing from the BuildKit frontend, and
# asking for it means the build fails outright behind a registry mirror that
# cannot serve `docker/dockerfile:1`.
#
# Build:
#   docker build -f Dockerfile.web.cuda -t nexllama/nexllama:web-cuda .
#
# Run:
#   docker run --rm --gpus all -p 8090:8090 -v "$PWD/models:/models:ro" \
#     nexllama/nexllama:web-cuda

ARG CUDA_VERSION=12.6.3

# Rust comes from the official image instead of rustup: the toolchain is then
# cached by Docker and the build does not depend on static.rust-lang.org.
FROM rust:1-slim-bullseye AS rust

# The UI is a static bundle; only its build needs Node. Keeping it a separate
# stage means the runtime image carries the compiled files and not the 200 MB of
# node_modules that produced them.
FROM node:22-bookworm-slim AS ui

WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu22.04 AS builder

ARG CRATES_MIRROR=
ARG FEATURES=cuda

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      curl ca-certificates build-essential clang libclang-dev llvm-dev \
      cmake ninja-build pkg-config git \
 && rm -rf /var/lib/apt/lists/*

# The devel image ships `libcuda.so` but not its SONAME alias. The ggml-cuda
# shared library records `libcuda.so.1` as NEEDED, so linking the tools fails
# with undefined `cu*` symbols without this; the driver supplies the real
# library at runtime. The alias also has to live in a default linker directory:
# `-L` paths do not apply to a NEEDED dependency of a shared library.
RUN ln -sf /usr/local/cuda/lib64/stubs/libcuda.so \
           /usr/local/cuda/lib64/stubs/libcuda.so.1 \
 && ln -sf /usr/local/cuda/lib64/stubs/libcuda.so \
           /usr/lib/x86_64-linux-gnu/libcuda.so.1

COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN if [ -n "$CRATES_MIRROR" ]; then \
      printf '[source.crates-io]\nreplace-with = "mirror"\n\n[source.mirror]\nregistry = "sparse+%s"\n' "$CRATES_MIRROR" > "$CARGO_HOME/config.toml"; \
    fi

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
# The root manifest patches `bindgen` to `vendor/bindgen`; without this path
# the build fails while resolving the patch, before anything is compiled.
COPY vendor ./vendor
# Every workspace member: the root `Cargo.toml` names them all, so one missing
# manifest is a hard error before anything is compiled. `crates/app` is the
# desktop app's own workspace and is excluded in `.dockerignore`.
COPY crates ./crates
RUN cargo build --release -p infer-daemon --features "$FEATURES"

FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu22.04 AS runtime

RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 libstdc++6 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/target/release/infer-daemon /usr/local/bin/infer-daemon
# The llama.cpp shared libraries go in a library directory, not in `bin`: the
# dynamic loader does not search `bin`, so the binary only started by luck of
# whatever fallback this base image happened to have.
COPY --from=builder /src/target/release/*.so* /usr/local/lib/
RUN ldconfig

# The app the daemon serves from `--ui-dir`.
COPY --from=ui /ui/dist /app/ui

# Unprivileged: reading model files and serving a port needs no root, and the
# daemon parses whatever GGUF it is pointed at.
RUN useradd --system --no-create-home --uid 10001 nexllama
USER nexllama

ENV RUST_LOG=info
EXPOSE 8090
VOLUME ["/models"]

ENTRYPOINT ["infer-daemon"]
# `--n-gpu-layers 999` is "offload everything", and setting
# `NEXLLAMA_API_KEY` is what makes the port want a token (the flag below only
# says the exposure was meant).
CMD ["--host", "0.0.0.0", "--port", "8090", \
     "--ui-dir", "/app/ui", "--models-dir", "/models", \
     "--n-gpu-layers", "999", "--allow-unauthenticated"]